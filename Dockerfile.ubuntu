# Alternative Dockerfile with Ubuntu base (if distroless has issues)
# Use this if you need shell access for debugging
# Build with: docker build -f Dockerfile.ubuntu -t jellyfin-m3u-export .

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install all dependencies
RUN npm ci

# Copy source code
COPY src ./src

# Build TypeScript
RUN npm run build

# Production stage - Ubuntu LTS with latest security patches
FROM ubuntu:24.04

# Install Node.js 20 and security updates
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

# Create non-root user
RUN useradd -r -u 1001 -g root nodejs && \
    mkdir -p /output /app/config && \
    chown -R nodejs:root /app /output /app/config

# Copy built application
COPY --from=builder --chown=nodejs:root /app/dist ./dist
COPY --from=builder --chown=nodejs:root /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:root /app/package*.json ./

USER nodejs

EXPOSE 3000

CMD ["node", "dist/index.js"]
