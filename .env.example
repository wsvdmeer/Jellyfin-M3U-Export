# ============================================================
# Jellyfin M3U Export Configuration
# ============================================================
# Copy this file to .env and update with your actual values
#
# OUTPUT ACCESS:
# - Files are saved to ./output/ directory
# - Access via HTTP: http://your-server-ip:3000/playlists/movies
# - Or mount output to share: ./output:/mnt/your-share/playlists
# ============================================================

# Jellyfin Configuration
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# Jellyseerr Configuration (optional)
JELLYSEERR_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=your_jellyseerr_api_key_here

# Server Configuration
PORT=3000
OUTPUT_DIR=/output

# Update interval in minutes (0 to disable auto-update)
UPDATE_INTERVAL=60
